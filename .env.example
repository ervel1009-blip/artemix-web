# ─────────────────────────────────────────────────────────────
# ARTEMIX — Variables de entorno
# Copia este archivo como .env.local y rellena los valores.
# En Vercel: Project Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# URL pública del sitio (sin slash final). Usada para SEO, sitemap y Open Graph.
# En Vercel debe coincidir con el dominio principal configurado en el proyecto.
NEXT_PUBLIC_SITE_URL=https://artemixsa.com

# Número de WhatsApp en formato internacional SIN "+", espacios ni guiones.
# Guatemala: 502 + 8 dígitos
NEXT_PUBLIC_WHATSAPP=50259468366

# Correo al que llegan las cotizaciones del formulario.
CONTACT_TO_EMAIL=erick.velasquez@artemixsa.com

# Resend — servicio de envío de correo (https://resend.com, plan gratuito disponible).
# Si dejas esto vacío, el formulario sigue funcionando vía WhatsApp y solo registra en logs.
RESEND_API_KEY=
RESEND_FROM_EMAIL=ARTEMIX <cotizaciones@artemixsa.com>

# Analítica opcional
NEXT_PUBLIC_GA_ID=
